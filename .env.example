# Canonical origin — used for metadataBase, canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.skpsolarworld.com

# Lead delivery. Until this is set, POST /api/leads validates and logs the lead
# but does not forward it (the form still shows its success state).
# Point this at your CRM webhook, an email service, or a Sanity write endpoint.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

