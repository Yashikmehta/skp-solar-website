# ============================================================================
# SKP SOLAR WORLD — ENVIRONMENT
# ============================================================================
# Copy to `.env.local` for local development, and add the same keys in the
# Vercel dashboard (Settings → Environment Variables) for production.
#
# NEVER commit `.env.local` or paste real keys into GitHub. `.env*` is already
# gitignored; only this example file is tracked.
# ============================================================================

# Canonical origin — metadataBase, canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.skpsolarworld.com


# --- Supabase: the PERMANENT lead record --------------------------------
# Dashboard → Project Settings → Data API (URL) and API Keys (anon key).
# Run `supabase/schema.sql` once to create the `leads` table.
# Required — if these are missing, enquiry forms return an error rather than
# showing a false success.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key — used ONLY by the admin panel to read leads back.
# The anon key above can insert but not read (row-level security), so this is
# required for /admin to show anything. It bypasses all security rules:
# server-side only, never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=


# --- Resend: lead notification email ------------------------------------
# resend.com → API Keys. Required for sales to be notified.
RESEND_API_KEY=

# Where enquiry notifications are delivered.
LEAD_NOTIFICATION_EMAIL=sales@skpsolarworld.com

# Sender address. Must be on a domain verified in Resend.
# Until skpsolarworld.com is verified there, Resend's shared sender
# "SKP Solar World <onboarding@resend.dev>" works but only delivers to the
# Resend account owner's own address.
LEAD_FROM_EMAIL=SKP Solar World <enquiries@skpsolarworld.com>


# --- Admin panel (/admin) -----------------------------------------------
# Password for the view-only admin panel. Use a long, unique passphrase —
# it is the only thing standing between the internet and your customer list.
ADMIN_PASSWORD=

# Signing key for the admin session cookie. Any random 32+ character string.
# Generate one with:  openssl rand -base64 32
# Changing this immediately signs out every admin session.
ADMIN_SESSION_SECRET=


# --- Sanity (not wired yet; see src/content/schemas.ts) -----------------
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=
